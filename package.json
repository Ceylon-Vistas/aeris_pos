{
  "name": "aeris_pos",
  "version": "1.0.0",
  "main": "dist/electron.js",
  "scripts": {
    "build": "tsc",
    "frontend": "cd frontend && npm run build",
    "start": "npm run frontend && npm run build && electron .",
    "dist": "npm run frontend && npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.aeris.pos",
    "productName": "AERIS POS",
    "files": [
      "dist/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}